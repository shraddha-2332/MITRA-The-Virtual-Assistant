PORT=4000
CORS_ORIGIN=http://127.0.0.1:5173
TOKEN_SECRET=replace-with-a-long-random-secret
DATABASE_FILE=./data/mitra.sqlite
# Optional grounded response generation. Keep this only in backend/.env.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional independently configured backup model; leave empty to disable cascading.
GEMINI_FALLBACK_MODEL=
TRUST_PROXY=false
ASSISTANT_RATE_LIMIT_MAX=30
